<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>LGTM Homebrew Tap — developer tools on tap</title>
  <meta name="description" content="A curated Homebrew tap for LGTM developer tools. brew tap lgtm-hq/tap and install lintro and winnow on macOS.">
  <meta property="og:title" content="LGTM Homebrew Tap">
  <meta property="og:description" content="Tools worth keeping on tap. Install and auto-update LGTM developer tools on macOS with Homebrew.">
  <meta name="color-scheme" content="dark light">
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    :root {
      --bg: #14100b; --bg-elev: #1c1710; --bg-window: #100c07;
      --ink: #ece0cd; --ink-dim: #9c8f79; --ink-faint: #6b5f4c;
      --amber: #ffb454; --amber-deep: #f59e2e; --green: #7bd88f; --red: #f2777a;
      --line: #2c2418; --line-soft: #221b12; --focus: #ffcf8a;
      --mono: ui-monospace, "SF Mono", "JetBrains Mono", "Cascadia Code", Menlo, Consolas, monospace;
      --radius: 8px; --maxw: 1080px;
    }
    @media (prefers-color-scheme: light) {
      :root {
        --bg: #f6efe2; --bg-elev: #efe6d5; --bg-window: #fbf6ec;
        --ink: #2a2015; --ink-dim: #6d6046; --ink-faint: #a2957a;
        --amber: #b5651d; --amber-deep: #9a5314; --green: #3f7d4f; --red: #b0413f;
        --line: #ddd0b8; --line-soft: #e6dcc7; --focus: #8a4a12;
      }
    }
    :root[data-theme="dark"] {
      --bg: #14100b; --bg-elev: #1c1710; --bg-window: #100c07;
      --ink: #ece0cd; --ink-dim: #9c8f79; --ink-faint: #6b5f4c;
      --amber: #ffb454; --amber-deep: #f59e2e; --green: #7bd88f; --red: #f2777a;
      --line: #2c2418; --line-soft: #221b12; --focus: #ffcf8a;
    }
    :root[data-theme="light"] {
      --bg: #f6efe2; --bg-elev: #efe6d5; --bg-window: #fbf6ec;
      --ink: #2a2015; --ink-dim: #6d6046; --ink-faint: #a2957a;
      --amber: #b5651d; --amber-deep: #9a5314; --green: #3f7d4f; --red: #b0413f;
      --line: #ddd0b8; --line-soft: #e6dcc7; --focus: #8a4a12;
    }

    body {
      margin: 0; background: var(--bg); color: var(--ink);
      font-family: var(--mono); line-height: 1.6; -webkit-font-smoothing: antialiased;
      background-image:
        radial-gradient(circle at 12% -10%, rgba(255,180,84,0.06), transparent 45%),
        repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(0,0,0,0.02) 3px, rgba(0,0,0,0.02) 4px);
    }
    img, svg { max-width: 100%; display: block; }
    button { font: inherit; }
    .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 clamp(18px, 4vw, 40px); }
    a { color: var(--amber); text-decoration: none; }
    a:hover { text-decoration: underline; text-underline-offset: 3px; }
    :focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; border-radius: 3px; }

    .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--line-soft); }
    .brand { display: flex; align-items: baseline; gap: 10px; font-weight: 600; letter-spacing: 0.02em; }
    .brand .sig { color: var(--amber); }
    .brand .path { color: var(--ink-dim); font-size: 0.82rem; }
    .bar nav { display: flex; gap: 20px; font-size: 0.84rem; color: var(--ink-dim); }
    .bar nav a { color: var(--ink-dim); }
    .bar nav a:hover { color: var(--amber); text-decoration: none; }

    .hero { padding: clamp(38px, 7vw, 84px) 0 clamp(28px, 5vw, 56px); }
    .eyebrow { font-size: 0.76rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--amber-deep); margin: 0 0 18px; }
    h1 { font-size: clamp(2rem, 5.6vw, 3.6rem); line-height: 1.05; margin: 0 0 18px; font-weight: 600; letter-spacing: -0.01em; text-wrap: balance; max-width: 18ch; }
    h1 .cur { color: var(--amber); animation: blink 1.1s step-end infinite; }
    @keyframes blink { 50% { opacity: 0; } }
    .lede { color: var(--ink-dim); font-size: 1.02rem; max-width: 60ch; margin: 0 0 30px; }

    .term { background: var(--bg-window); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: 0 24px 60px -30px rgba(0,0,0,0.7), inset 0 1px 0 rgba(255,255,255,0.02); overflow: hidden; }
    .term__chrome { display: flex; align-items: center; gap: 8px; padding: 11px 14px; border-bottom: 1px solid var(--line); background: linear-gradient(var(--bg-elev), var(--bg-window)); }
    .dot { width: 11px; height: 11px; border-radius: 50%; background: var(--line); }
    .dot.r { background: #e05b53; } .dot.y { background: #e0a53f; } .dot.g { background: #62b972; }
    .term__title { margin-left: 8px; font-size: 0.78rem; color: var(--ink-faint); letter-spacing: 0.03em; }
    .term__body { padding: 20px clamp(16px, 3vw, 26px) 24px; font-size: 0.92rem; overflow-x: auto; }
    .line { white-space: pre; }
    /* typing animation: JS adds .is-typing; without JS / reduced-motion, all lines show */
    .term__body.is-typing .line { visibility: hidden; }
    .prompt { color: var(--green); }
    .prompt .tilde { color: var(--ink-dim); }
    .cmd { color: var(--ink); }
    .out { color: var(--ink-dim); }
    .ok { color: var(--green); }
    .warn { color: var(--amber); }
    .muted { color: var(--ink-faint); }

    .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; align-items: center; }
    .btn { font-family: var(--mono); font-size: 0.9rem; cursor: pointer; border: 1px solid var(--amber); color: var(--bg); background: var(--amber); padding: 11px 18px; border-radius: 6px; font-weight: 600; letter-spacing: 0.01em; transition: transform 0.08s ease, background 0.15s ease; }
    .btn:hover { background: var(--amber-deep); transform: translateY(-1px); }
    .btn.ghost { background: transparent; color: var(--ink); border-color: var(--line); }
    .btn.ghost:hover { border-color: var(--amber); color: var(--amber); background: transparent; }
    .hint { color: var(--ink-faint); font-size: 0.82rem; }

    .sec { padding: clamp(40px, 6vw, 72px) 0; border-top: 1px solid var(--line-soft); }
    .sec__head { display: flex; align-items: baseline; gap: 14px; margin-bottom: 30px; }
    .sec__head h2 { font-size: 1.05rem; font-weight: 600; margin: 0; letter-spacing: 0.02em; }
    .sec__head .n { color: var(--amber); font-size: 0.82rem; }
    .sec__head .rule { flex: 1; height: 1px; background: var(--line); align-self: center; }

    .catalog { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); align-items: start; }
    .card { background: var(--bg-elev); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 18px 16px; display: flex; flex-direction: column; gap: 12px; transition: border-color 0.15s ease, transform 0.1s ease; }
    .card:hover { border-color: var(--amber); transform: translateY(-2px); }
    .card__top { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
    .card__name { font-size: 1.06rem; font-weight: 600; color: var(--ink); }
    .ver { font-size: 0.74rem; color: var(--amber); border: 1px solid var(--line); padding: 2px 8px; border-radius: 999px; font-variant-numeric: tabular-nums; background: rgba(255,180,84,0.06); }
    .card__desc { color: var(--ink-dim); font-size: 0.9rem; margin: 0; }
    .tags { display: flex; flex-wrap: wrap; gap: 6px; }
    .tag { font-size: 0.7rem; letter-spacing: 0.04em; color: var(--ink-faint); border: 1px solid var(--line-soft); padding: 2px 7px; border-radius: 4px; text-transform: uppercase; }

    /* variants: one tool, multiple install modes */
    .variants { display: flex; flex-direction: column; gap: 12px; margin-top: 2px; }
    .variant { border: 1px solid var(--line-soft); border-radius: 6px; padding: 12px; display: flex; flex-direction: column; gap: 9px; background: var(--bg-window); }
    .variant__h { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .variant__name { font-size: 0.9rem; font-weight: 600; color: var(--ink); }

    .install { display: flex; align-items: center; gap: 10px; background: var(--bg-window); border: 1px solid var(--line-soft); border-radius: 6px; padding: 9px 10px 9px 12px; }
    .variant .install { background: var(--bg-elev); }
    .install code { color: var(--ink); font-size: 0.82rem; white-space: nowrap; overflow-x: auto; min-width: 0; flex: 1; }
    .install code .p { color: var(--green); }
    .copy { flex: none; cursor: pointer; font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.05em; text-transform: uppercase; color: var(--ink-dim); background: transparent; border: 1px solid var(--line); padding: 4px 9px; border-radius: 4px; transition: color 0.15s, border-color 0.15s; }
    .copy:hover { color: var(--amber); border-color: var(--amber); }
    .copy.done { color: var(--green); border-color: var(--green); }

    .flow { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
    .step { border: 1px solid var(--line); border-radius: var(--radius); padding: 16px 16px 18px; background: var(--bg-elev); }
    .step .k { color: var(--amber); font-size: 0.8rem; }
    .step h3 { font-size: 0.95rem; margin: 8px 0 6px; font-weight: 600; }
    .step p { margin: 0; color: var(--ink-dim); font-size: 0.86rem; }

    footer { border-top: 1px solid var(--line-soft); padding: 28px 0 48px; color: var(--ink-faint); font-size: 0.82rem; }
    .foot-row { display: flex; flex-wrap: wrap; gap: 18px; justify-content: space-between; align-items: center; }
    .foot-links { display: flex; gap: 18px; }
    .foot-links a { color: var(--ink-dim); }

    @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }
  </style>
</head>
<body>
  <div class="wrap">
    <header class="bar">
      <div class="brand"><span class="sig">&#8776;</span> lgtm-hq<span class="path">/homebrew-tap</span></div>
      <nav>
        <a href="#install">install</a>
        <a href="#formulae">formulae</a>
        <a href="#flow">how it works</a>
        <a href="https://github.com/lgtm-hq/homebrew-tap">github &#8599;</a>
      </nav>
    </header>

    <section class="hero">
      <p class="eyebrow">Homebrew tap &middot; macOS</p>
      <h1>Tools worth keeping on tap.<span class="cur">&#9614;</span></h1>
      <p class="lede">A curated set of developer tools &mdash; code quality, media tooling &mdash; packaged for Homebrew and kept current automatically. Tap once, install by name, upgrade with the rest of your machine.</p>

      <div class="term" id="install">
        <div class="term__chrome">
          <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
          <span class="term__title">zsh &mdash; brew &mdash; 80&times;24</span>
        </div>
        <div class="term__body">
<div class="line"><span class="prompt">&#10148; <span class="tilde">~</span></span> <span class="cmd">brew tap lgtm-hq/tap</span></div>
<div class="line out">==&gt; Tapping lgtm-hq/tap</div>
<div class="line out">Tapped 3 formulae (24 files, 41KB).</div>
<div class="line"> </div>
<div class="line"><span class="prompt">&#10148; <span class="tilde">~</span></span> <span class="cmd">brew install lintro</span></div>
<div class="line out">==&gt; Fetching lgtm-hq/tap/lintro</div>
<div class="line"><span class="ok">&#127866;  /opt/homebrew/Cellar/lintro</span> <span class="muted">&middot;  Poured from bottle</span></div>
<div class="line"> </div>
<div class="line"><span class="prompt">&#10148; <span class="tilde">~</span></span> <span class="cmd">lintro --version</span></div>
<div class="line"><span class="warn">lintro (installed)</span></div>
        </div>
      </div>

      <div class="cta-row">
        <button class="btn" data-copy="brew tap lgtm-hq/tap">Copy tap command</button>
        <a class="btn ghost" href="https://github.com/lgtm-hq/homebrew-tap">Browse the source</a>
        <span class="hint">requires macOS 10.15+ and Homebrew</span>
      </div>
    </section>

    <section class="sec" id="formulae">
      <div class="sec__head">
        <span class="n">$</span><h2>brew search lgtm-hq/tap</h2><span class="rule"></span>
      </div>
      <div class="catalog">
{{PRODUCT_CARDS}}
      </div>
    </section>

    <section class="sec" id="flow">
      <div class="sec__head">
        <span class="n">#</span><h2>Always current, without you</h2><span class="rule"></span>
      </div>
      <div class="flow">
        <div class="step"><div class="k">upstream</div><h3>A tool ships a release</h3><p>lintro or winnow cuts a version and signals the tap over a <code>repository_dispatch</code> event.</p></div>
        <div class="step"><div class="k">tap</div><h3>The formula regenerates</h3><p>The tap rebuilds the formula from the release artifacts, verifies every SHA256, and opens a pull request.</p></div>
        <div class="step"><div class="k">ci</div><h3>It validates itself</h3><p>Style, audit, and a real install run on a clean macOS runner. Green means the formula actually works.</p></div>
        <div class="step"><div class="k">merge</div><h3>You just <code>brew upgrade</code></h3><p>Validated updates merge automatically, so <code>brew upgrade</code> is all you ever run.</p></div>
      </div>
    </section>

    <footer>
      <div class="foot-row">
        <div>&#8776; lgtm-hq/homebrew-tap &mdash; MIT licensed</div>
        <div class="foot-links">
          <a href="https://github.com/lgtm-hq/homebrew-tap">GitHub</a>
          <a href="https://github.com/lgtm-hq/homebrew-tap/issues">Issues</a>
          <a href="https://github.com/lgtm-hq/homebrew-tap/blob/main/CONTRIBUTING.md">Contributing</a>
        </div>
      </div>
    </footer>
  </div>

  <script>
    (function () {
      // Copy buttons — always live, independent of the typing animation.
      function flash(btn, label) {
        var prev = btn.getAttribute("data-label") || btn.textContent;
        btn.setAttribute("data-label", prev);
        btn.textContent = label; btn.classList.add("done");
        setTimeout(function () { btn.textContent = prev; btn.classList.remove("done"); }, 1400);
      }
      document.querySelectorAll("[data-copy]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var text = btn.getAttribute("data-copy");
          if (!navigator.clipboard) return;
          navigator.clipboard.writeText(text).then(function () {
            flash(btn, btn.classList.contains("copy") ? "copied" : "✓ copied");
          }).catch(function () {});
        });
      });

      // Hero typing animation — progressive enhancement, reduced-motion aware,
      // once, skippable; content is fully present without JS.
      var body = document.querySelector(".term__body");
      var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!body || reduce) return;

      var lines = Array.prototype.slice.call(body.querySelectorAll(".line"));
      var steps = lines.map(function (line) {
        var cmd = line.querySelector(".cmd");
        return { line: line, cmd: cmd, text: cmd ? cmd.textContent : null };
      });
      var done = false, i = 0;

      function finish() {
        if (done) return;
        done = true;
        body.classList.remove("is-typing");
        steps.forEach(function (s) {
          s.line.style.visibility = "";
          if (s.cmd) s.cmd.textContent = s.text;
        });
      }
      function typeCmd(s, cb) {
        var j = 0;
        (function tick() {
          if (done) return;
          s.cmd.textContent = s.text.slice(0, ++j);
          if (j < s.text.length) setTimeout(tick, 26); else cb();
        })();
      }
      function nextLine() {
        if (done) return;
        if (i >= steps.length) { finish(); return; }
        var s = steps[i];
        s.line.style.visibility = "visible";
        if (s.cmd) { typeCmd(s, function () { i++; setTimeout(nextLine, 150); }); }
        else { i++; setTimeout(nextLine, 110); }
      }

      body.classList.add("is-typing");
      steps.forEach(function (s) { if (s.cmd) s.cmd.textContent = ""; });
      ["click", "keydown", "wheel", "touchstart"].forEach(function (ev) {
        window.addEventListener(ev, finish, { once: true, passive: true });
      });
      requestAnimationFrame(function () { setTimeout(nextLine, 260); });
    })();
  </script>
</body>
</html>
